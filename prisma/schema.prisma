// Scrumbler — planning poker + daily-lead wheel
// Neon Postgres via the Prisma Neon driver adapter.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// A permanent, shareable room. `slug` is the public URL; `adminToken` is the
/// private capability that grants settings/wheel/round control.
model Room {
  id         String @id @default(cuid())
  slug       String @unique
  name       String
  adminToken String @unique
  /// The read-only link (`/w/<watchToken>`). A capability like `adminToken`,
  /// but a weaker one: it reads the room and nothing else, and it never leads
  /// back to `slug` — so a stakeholder holding it can watch, never vote.
  /// The create route mints it; the database default is a safety net, so code
  /// deployed before this column existed can still create rooms.
  watchToken String @unique @default(dbgenerated("replace((gen_random_uuid())::text, '-'::text, ''::text)"))

  // --- planning poker settings (admin tweakable) ---
  deckKey     String  @default("fibonacci")
  customDeck  String? // comma-separated, only read when deckKey == "custom"
  autoReveal  Boolean @default(true)
  allowRevote Boolean @default(true)
  showAverage Boolean @default(true)
  allowSpectatorVote Boolean @default(false)

  // --- wheel settings (admin tweakable) ---
  /// Whether anyone in the room may spin, or only the admin. On by default:
  /// the wheel is a group ritual and waiting on one person to press the button
  /// is the thing it exists to replace. An admin can close it again from
  /// Settings when a room gets rowdy.
  allowAnyoneToSpin Boolean @default(true)
  /// Whether the name the wheel lands on leaves the wheel afterwards. On by
  /// default: a rotation that does not shrink draws the same person twice.
  /// Applied by whichever client watched the wheel stop, never at spin time —
  /// see the settle route for why.
  dropWinnerAfterSpin Boolean @default(true)
  /// The name the next draw must skip, or null when there is none.
  ///
  /// Set when a shrinking wheel empties and refills itself. Everybody goes back
  /// on the wheel, that name included — it is the draw that skips them, not the
  /// wheel, so that nobody leads two dailies running across the seam. The spin
  /// route clears it as it serves it: a hold is one draw long. A label rather
  /// than an id because that is what a spin records, and labels are unique per
  /// room anyway.
  wheelHeldOverLabel String?
  /// The spin the wheel roster has already been settled for.
  ///
  /// Every client watching a wheel asks the settle route to apply the result,
  /// so all but the first must find the work done. The roster alone cannot say
  /// whether it was: a rotation that has closed puts the winner back on the
  /// wheel, leaving it looking exactly like a draw nobody has settled yet.
  wheelSettledSpinId String?

  // --- discussion timer (one per room, shared by everyone) ---
  /// Whether anyone in the room may start, pause and stop the timer, or only
  /// the admin. Open by default for the same reason the wheel is.
  allowAnyoneToTime Boolean @default(true)
  /// Running: when it hits zero. Null while paused or idle.
  timerEndsAt DateTime?
  /// Paused: what was left (negative once into overtime). Null otherwise.
  timerPausedMs Int?
  /// The full length, extensions included — what the progress bar is out of.
  /// Null means there is no timer at all.
  timerDurationMs Int?
  timerLabel String?

  /// Monotonic counter bumped by every mutation. The SSE stream watches this
  /// single column so a poll costs one tiny indexed read.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants Participant[]
  rounds       Round[]
  wheelEntries WheelEntry[]
  spins        Spin[]

  @@index([updatedAt])
  /// The creation brake counts the last hour of rooms; cleanup finds old ones.
  @@index([createdAt])
}

/// Someone in the room. Identified by a browser-generated `clientId` — no auth.
model Participant {
  id          String   @id @default(cuid())
  roomId      String
  name        String
  clientId    String
  isSpectator Boolean  @default(false)
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  room  Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  votes Vote[]

  @@unique([roomId, clientId])
  @@index([roomId, lastSeenAt])
}

/// One estimation round. A room always has exactly one "current" round: the
/// highest `number`.
model Round {
  id         String    @id @default(cuid())
  roomId     String
  number     Int
  topic      String?
  revealed   Boolean   @default(false)
  revealedAt DateTime?
  createdAt  DateTime  @default(now())

  room  Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  votes Vote[]

  @@unique([roomId, number])
  @@index([roomId, number(sort: Desc)])
}

model Vote {
  id            String   @id @default(cuid())
  roundId       String
  participantId String
  value         String
  createdAt     DateTime @default(now())

  round       Round       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([roundId, participantId])
  @@index([roundId])
}

/// A name on the daily-lead wheel. Deliberately NOT tied to Participant:
/// the admin can seed the wheel with teammates who have not opened the room.
model WheelEntry {
  id       String   @id @default(cuid())
  roomId   String
  label    String
  active   Boolean  @default(true)
  position Int      @default(0)
  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, label])
  @@index([roomId, position])
}

/// History of wheel results, so "who led last time" survives a refresh.
model Spin {
  id         String   @id @default(cuid())
  roomId     String
  winnerLabel String
  createdAt  DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt(sort: Desc)])
}

/// Fixed-window request counters for the public write routes that create rows
/// (rooms, seats). Kept in Postgres rather than memory because serverless
/// instances share nothing — and rather than Redis, because one small table is
/// cheaper than a second service. `key` is "<bucket>:<sha256 of the IP>", so no
/// address is ever stored. The daily cleanup drops windows that have closed.
model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int      @default(1)

  @@index([windowStart])
}
