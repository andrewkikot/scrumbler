# ---------------------------------------------------------------------------
# Neon Postgres (free plan is plenty for this)
#
# In the Neon console open your project -> Connect, and copy BOTH strings.
# Vercel's Neon integration sets these two names for you automatically.
# ---------------------------------------------------------------------------

# Pooled connection (host contains "-pooler"). The running app uses this one:
# serverless functions open and drop connections constantly, and the pooler is
# what keeps that from exhausting the database.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-123456-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Direct connection (same host, without "-pooler"). Prisma Migrate needs this:
# migrations take advisory locks, which cannot travel through PgBouncer.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require"
