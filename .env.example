# ---------------------------------------------------------------------------
# Neon Postgres (the free plan is plenty for this)
#
# In the Neon console open your project -> Connect and copy the string twice:
# once with connection pooling ON, once with it OFF.
# ---------------------------------------------------------------------------

# Pooled connection (host contains "-pooler"). The running app uses this one:
# serverless functions open and drop connections constantly, and the pooler is
# what keeps that from exhausting the database.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-123456-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Direct connection (same host, without "-pooler"). Prisma Migrate needs this:
# migrations take advisory locks, which cannot travel through PgBouncer.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-example-123456.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Prefixed names
#
# Vercel's Neon integration prefixes its variables when the plain names are
# already claimed - by another project, or by a team-wide shared variable. This
# deployment uses SCRUMBLER_, so on Vercel the two variables above are named:
#
#   SCRUMBLER_DATABASE_URL
#   SCRUMBLER_DATABASE_URL_UNPOOLED
#
# Both spellings work, and the prefixed one wins if both are present - see
# src/lib/env.ts. A team-level DATABASE_URL belonging to a different project can
# be visible here too, and silently connecting to the wrong database is worse
# than failing to start.
#
# SCRUMBLER_DATABASE_URL="..."
# SCRUMBLER_DATABASE_URL_UNPOOLED="..."
# ---------------------------------------------------------------------------
